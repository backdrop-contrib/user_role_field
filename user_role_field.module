<?php

/**
 * @file
 * User role field module.
 */

/**
 * Hook into field edit form, user registration form and profile forms.
 */
function user_role_field_form_alter(&$form, $form_state, $form_id) {
  if (isset($form['instance']) && ($form['instance']['entity_type']['#value'] == 'user' || $form['instance']['entity_type']['#value'] == 'profile')
    && $form_id == 'field_ui_field_edit_form' && isset($form['field'])) {
    module_load_include('inc', 'user_role_field', 'user_role_field.admin');
    _user_role_field_field_settings_form_alter($form, $form_state, $form_id);
  }
}

/**
 * Custom permissions.
 */
function user_role_field_permission() {
  return array(
    'administer user field roles' => array(
      'title' => t('Administer user field roles'),
      'description' => t('Manage user field roles.'),
    ),
  );
}

/**
 * Roles that have access to the field
 *
 * @param array $field
 *   Array of field info.
 * @return array
 *   Array of roles.
 */
function _user_role_field_roles($field) {
  return (isset($field['settings']['user_role_field']['roles']) && is_array($field['settings']['user_role_field']['roles']) ? array_filter($field['settings']['user_role_field']['roles']) : array());
}

/**
 * Implements hook_field_access().
 *
 * Make sure only appropriate roles have access
 */
function user_role_field_field_access($op, $field, $entity_type, $entity, $account) {
  // We only handle user fields and profile fields
  if (($entity_type != 'user') && ($entity_type != 'profile'))
    return true;

  // Admin user can see all fields when creating a new user.
  if (arg(2) == 'create' && arg(0) == 'admin' && user_access('administer permissions'))
    return true;

  // If the object type is profile, we need to load the user owning profile object.
  if ($entity_type == 'profile' && !empty($entity->uid))
    $entity = user_load($entity->uid);

  // Ignore the request if roles have not been enabled for this field.
  $roles = _user_role_field_roles($field);
  if (empty($roles)) {
    return TRUE;
  }

  // If the user object doesn't have the roles property, we get here through
  // the views module for example. In that case we want the data to display.
  // To revisit in case there are other cases.
  if (!isset($entity->roles)) {
    return TRUE;
  }

  // The user hasn't been created yet, such as on a registration page.
  // It will have authenticated role by default so won't match with the
  // anonymous user. So check instead if roles includes anonymous role.
  if (empty($entity->uid) && in_array(BACKDROP_ANONYMOUS_ROLE, $roles)) {
    return TRUE;
  }

  $matching_roles = count(array_intersect($entity->roles, $roles));
  $negate = $field['settings']['user_role_field']['negate'] ?? 0;
  if ($negate) {
    return !$matching_roles;
  }
  else {
    return $matching_roles;
  }
}
